{
  "manifest_version": 3,
  "name": "Academic Assistant",
  "version": "2.0",
  "description": "Универсальный инструмент аудита клиентской части тестирования",
  "permissions": ["scripting"],
  "host_permissions": [
    "*://*.sielom.ru/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.sielom.ru/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}